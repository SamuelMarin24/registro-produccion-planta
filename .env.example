# Copia este archivo como .env y ajusta las rutas a tu entorno.
# Pueden ser rutas locales o de red (ej. Z:\Produccion\Datos).

# Carpeta compartida donde viven los datos (base de todo lo demas)
CARPETA_DATOS=C:\ruta\a\datos

# Archivos maestros (opcional: por defecto salen de CARPETA_DATOS)
# ARCHIVO_MAESTRAS=C:\ruta\a\datos\MAESTRAS.xlsx
# ARCHIVO_OP=C:\ruta\a\datos\BD_ORDENES_PRODUCCION.xlsx
# ARCHIVO_CONSOLIDADO=C:\ruta\a\datos\BD_PRODUCCION.xlsx

# Carpetas del flujo archivo -> consolidador (opcional)
# CARPETA_PENDIENTES=C:\ruta\a\datos\PENDIENTES
# CARPETA_PROCESADOS=C:\ruta\a\datos\PROCESADOS

# Cada cuantos minutos la app recarga maestras y ordenes de produccion
INTERVALO_RECARGA_MIN=10

# Cada cuantos segundos el consolidador revisa la carpeta PENDIENTES
CICLO_SEGUNDOS=30

# Titulo de la ventana y texto del encabezado
NOMBRE_APP=Registro de Produccion
TEXTO_LOGO=PLANTA
